# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./bug_copilot.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bug_copilot

# Redis (optional, for job queue in Phase 2)
REDIS_URL=redis://localhost:6379/0

# LLM
ANTHROPIC_API_KEY=sk-ant-xxxxx

# GitHub MCP / Direct API
GITHUB_TOKEN=ghp_xxxxx

# Atlassian MCP / Direct API
JIRA_BASE_URL=https://yoursite.atlassian.net
JIRA_API_TOKEN=xxxxx
CONFLUENCE_BASE_URL=https://yoursite.atlassian.net/wiki

# Provider mode: mock | mcp | direct
PROVIDER_MODE=mock

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
