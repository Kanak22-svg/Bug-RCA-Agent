# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./bugcopilot.db

# --- Provider selection ---
# "mock" runs without credentials. Switch to "mcp" for real MCP servers.
ISSUE_PROVIDER=mock
DOCS_PROVIDER=mock
CODE_PROVIDER=mock

# --- Atlassian Rovo MCP (Jira + Confluence) ---
# Hosted remote MCP endpoint per Atlassian docs.
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v1/sse
ATLASSIAN_MCP_TOKEN=

# --- GitHub MCP Server ---
# Either remote (hosted) or local stdio command.
# For remote streamable HTTP:
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp
GITHUB_MCP_TOKEN=
# For local stdio (alternative): set GITHUB_MCP_STDIO=1 and provide command:
GITHUB_MCP_STDIO=0
GITHUB_MCP_COMMAND=docker run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server

# --- LLM ---
# OpenAI-compatible endpoint. Leave OPENAI_API_KEY empty to use a deterministic
# heuristic fallback for intent/regression reasoning (works without an LLM).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
